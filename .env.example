# Để trống: bản trải nghiệm, không gửi đơn hàng/đặt chỗ thật.
# Chỉ dùng phía server. Không dùng NEXT_PUBLIC_ cho token hoặc API key.
API_BASE_URL=
# Tắt mặc định. Chỉ bật tại môi trường tích hợp/staging đã kiểm thử.
# Không bật thanh toán, giao vận hoặc email/SMS provider thật bằng biến này.
STOREFRONT_WRITES_ENABLED=false
# Tùy chọn: đúng một HTTPS origin khi proxy nội bộ khiến URL request khác origin trình duyệt.
# So khớp chính xác; không dùng wildcard. Để trống ở local/dev nếu không cần.
# HTTPS preview dùng Secure/SameSite=None để giữ phiên khi nhúng; local giữ Lax.
PREVIEW_ORIGIN=
# Origin public của frontend, dùng cho metadata/sitemap ở production.
SITE_URL=http://localhost:3000

# Tùy chọn cho các server test chạy song song; production mặc định .next.
# NEXT_DIST_DIR=.next-integration
